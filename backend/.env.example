# Copy this file to ".env" for local dev.
# On Render (or whichever host you use) set these as real Environment Variables
# in the dashboard -- never commit an actual ".env" file to GitHub.

# Port the server listens on (most hosts set this automatically, but keep a default)
PORT=3000

# Comma-separated list of origins allowed to connect (your GitHub Pages URL).
# Example: https://yourusername.github.io
ALLOWED_ORIGINS=http://localhost:5500,https://yourusername.github.io

# Secret token the "owner" (you, the dev) types in the app to clear the group chat.
# Pick something long and random for real use -- do NOT keep the default below.
OWNER_TOKEN=change-me-to-something-long-and-random

# ---- Free TURN server (optional but recommended) ----
# Voice chat works with only STUN when both users have "easy" NATs, but many
# real-world networks (mobile data, corporate NAT, some home routers) need a
# TURN relay or the call never connects. Open Relay Project (metered.ca) gives
# free TURN credentials. Sign up at https://www.metered.ca/tools/openrelay/
# (free tier: 20GB/month bandwidth) and put your credentials here.
# If you leave these blank, the app still works but calls across strict NATs
# may fail to connect -- see README "Troubleshooting" section.
TURN_URL=turn:relay.example.com:80
TURN_USERNAME=
TURN_CREDENTIAL=
